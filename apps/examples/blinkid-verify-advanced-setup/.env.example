# For development, create a .env.local or a .env.production using this template
# Never put your licence key in this file as it will be commited

# https://vitejs.dev/guide/env-and-mode.html#env-files


VITE_LICENCE_KEY=PLACE_YOUR_LICENCE_KEY_HERE

# Server-side only. Vite reads these and does not inline them into the page.
# The example posts to /api/v3/verify on this dev server.
# VERIFY_API_URL is the https origin. The forwarded path is always /api/v3/verify on that host.
# VERIFY_API_KEY is optional. When set, that string is the Authorization header value.
VERIFY_API_URL=https://your-verify-api.example.com
VERIFY_API_KEY=
