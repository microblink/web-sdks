// https://nodejs.org/api/typescript.html#type-stripping
{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "nodenext",
    "noImplicitAny": false,
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.mts"]
}
