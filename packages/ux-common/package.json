{
  "name": "@microblink/ux-common",
  "version": "1.1.0",
  "private": true,
  "keywords": [],
  "license": "ISC",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "exports": {
    "./hapticFeedback": {
      "types": "./types/hapticFeedback.d.ts",
      "import": "./dist/hapticFeedback.js"
    },
    "./utils": {
      "types": "./types/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./cameraAnalyticsMappers": {
      "types": "./types/cameraAnalyticsMappers.d.ts",
      "import": "./dist/cameraAnalyticsMappers.js"
    },
    "./deviceOrientationAnalytics": {
      "types": "./types/deviceOrientationAnalytics.d.ts",
      "import": "./dist/deviceOrientationAnalytics.js"
    },
    "./RafLoop": {
      "types": "./types/RafLoop.d.ts",
      "import": "./dist/RafLoop.js"
    },
    "./UxTimeoutHandler": {
      "types": "./types/UxTimeoutHandler.d.ts",
      "import": "./dist/UxTimeoutHandler.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:types": "tsc --emitDeclarationOnly",
    "build:publish": "tsc",
    "clean": "rimraf .turbo types dist *.tgz",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@microblink/analytics": "workspace:^",
    "@microblink/camera-manager": "workspace:^"
  },
  "devDependencies": {
    "@microblink/tsconfig": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "@vitest/browser-playwright": "catalog:test",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "typescript": "catalog:typescript",
    "vitest": "catalog:test"
  }
}
