{
  "extends": "@microblink/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "vite-plugin-solid-svg/types"],
    "paths": {
      "@microblink/biometrics-ux-manager/core": ["./src/core.ts"]
    }
  },
  "include": ["src", "test"]
}
