{
  "name": "@microblink/blinkid-verify-ux-manager",
  "version": "4000.0.0-next.1",
  "description": "BlinkID Verify UX Manager provides user feedback based on the blinkid-verify process results.",
  "keywords": [
    "aml",
    "blinkid-verify",
    "compliance",
    "computer-vision",
    "document-authentification",
    "document-scanner",
    "document-verification",
    "driver-license",
    "fraud-detection",
    "frontend",
    "id-check",
    "id-verification",
    "image-processing",
    "kyc",
    "microblink",
    "ocr",
    "passport-verification",
    "typescript",
    "verification",
    "verify",
    "video",
    "wasm",
    "webassembly"
  ],
  "license": "ISC",
  "author": "Microblink",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "./dist/blinkid-verify-ux-manager.js",
  "module": "./dist/blinkid-verify-ux-manager.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/blinkid-verify-ux-manager.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./ui": {
      "types": "./types/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "publish",
    "linkDirectory": false
  },
  "scripts": {
    "build": "pnpm run --no-bail \"/^build:(js|types)$/\"",
    "build:dev": "pnpm run --no-bail \"/^build:(js-dev|types)$/\"",
    "build:js": "vite build --mode ${VITE_BUILD_MODE:-production}",
    "build:js-dev": "vite build --mode development",
    "build:publish": "pnpm build && pnpm type-rollup",
    "build:types": "tsc",
    "clean": "rimraf .turbo types dist publish public/resources/* *.tgz",
    "docs:api": "typedoc",
    "lint:browser-entrypoints": "BROWSERSLIST_ENV=core oxlint src/core.ts src/core && BROWSERSLIST_ENV=ui oxlint src/ui.ts src/ui",
    "pack-check": "pnpm pack | tail -n1 | xargs attw --profile esm-only && publint publish",
    "prepack": "pnpm prepare-publish",
    "prepare-publish": "tsx scripts/prepare-publish.mts",
    "publish-test": "pnpm pack-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-rollup": "bundle-declarations --entry core --entry ui --compatibility-root --bundle @microblink/feedback-stabilizer --bundle @microblink/ux-common",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@microblink/blinkid-verify-core": "workspace:^",
    "@microblink/camera-manager": "workspace:^",
    "clsx": "catalog:",
    "merge-anything": "catalog:",
    "perfect-debounce": "catalog:",
    "solid-motionone": "catalog:ui",
    "ts-pattern": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:publish",
    "@microblink/feedback-stabilizer": "workspace:^",
    "@microblink/repo-utils": "workspace:*",
    "@microblink/shared-components": "workspace:^",
    "@microblink/tsconfig": "workspace:*",
    "@microblink/unocss-config": "workspace:*",
    "@microblink/ux-common": "workspace:^",
    "@typescript/native": "catalog:typescript",
    "@vitest/browser-playwright": "catalog:test",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "publint": "catalog:publish",
    "rimraf": "catalog:utils",
    "sass": "catalog:ui",
    "tsx": "catalog:typescript",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "unocss": "catalog:ui",
    "vite": "catalog:vite",
    "vite-plugin-css-injected-by-js": "catalog:vite",
    "vite-plugin-externalize-dependencies": "catalog:vite",
    "vite-plugin-solid": "catalog:vite",
    "vite-plugin-solid-svg": "catalog:vite",
    "vitest": "catalog:test",
    "write-package": "catalog:publish",
    "zx": "catalog:utils"
  },
  "peerDependencies": {
    "@ark-ui/solid": "catalog:ui",
    "@solid-primitives/keyed": "catalog:ui",
    "solid-js": "catalog:ui",
    "solid-zustand": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "@ark-ui/solid": {
      "optional": true
    },
    "@solid-primitives/keyed": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "solid-zustand": {
      "optional": true
    }
  },
  "browserslist": {
    "production": [
      "Chrome >= 96",
      "ChromeAndroid >= 96",
      "Edge >= 96",
      "Opera >= 84",
      "Firefox >= 132",
      "Safari >= 16.4",
      "iOS >= 16.4"
    ],
    "core": [
      "Chrome >= 96",
      "ChromeAndroid >= 96",
      "Edge >= 96",
      "Opera >= 84",
      "Firefox >= 132",
      "Safari >= 16.4",
      "iOS >= 16.4"
    ],
    "ui": [
      "Chrome >= 96",
      "ChromeAndroid >= 96",
      "Edge >= 96",
      "Opera >= 84",
      "Firefox >= 132",
      "Safari >= 16.4",
      "iOS >= 16.4"
    ]
  }
}
