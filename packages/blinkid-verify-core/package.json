{
  "name": "@microblink/blinkid-verify-core",
  "version": "4000.0.0-next.1",
  "description": "BlinkID Verify Core SDK",
  "keywords": [
    "aml",
    "blinkid",
    "blinkid-verify",
    "compliance",
    "computer-vision",
    "document-authentification",
    "document-scanner",
    "document-verification",
    "driver-license",
    "fraud-detection",
    "frontend",
    "id-check",
    "id-verification",
    "image-processing",
    "kyc",
    "microblink",
    "ocr",
    "passport-verification",
    "typescript",
    "verification",
    "verify",
    "video",
    "wasm",
    "webassembly"
  ],
  "license": "ISC",
  "author": "Microblink",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "./dist/blinkid-verify-core.js",
  "module": "./dist/blinkid-verify-core.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/blinkid-verify-core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "publish",
    "linkDirectory": false
  },
  "scripts": {
    "build": "pnpm run --no-bail \"/^build:(js|types)$/\"",
    "build:js": "vite build --mode ${VITE_BUILD_MODE:-production}",
    "build:js-dev": "vite build --mode development",
    "build:publish": "pnpm build && pnpm type-rollup",
    "build:types": "tsc",
    "clean": "rimraf .turbo types dist publish public/resources/* *.tgz",
    "docs:api": "typedoc",
    "pack-check": "pnpm pack | tail -n1 | xargs attw --profile esm-only && publint publish",
    "prepack": "pnpm prepare-publish",
    "prepare-publish": "tsx scripts/prepare-publish.mts",
    "publish-test": "pnpm prepare-publish && pnpm pack-check",
    "type-rollup": "bundle-declarations --entry index --bundle @microblink/analytics --bundle @microblink/blinkid-verify-wasm --bundle @microblink/blinkid-verify-worker --bundle @microblink/core-common --bundle @microblink/wasm-common --bundle @microblink/worker-common",
    "watch": "pnpm run --no-bail \"/^watch:(js|types)$/\"",
    "watch:js": "pnpm run build:js --watch --mode development",
    "watch:types": "pnpm run build:types --watch",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@microblink/analytics": "workspace:*",
    "@microblink/blinkid-verify-wasm": "workspace:*",
    "@microblink/blinkid-verify-worker": "workspace:*",
    "@microblink/core-common": "workspace:*",
    "comlink": "catalog:",
    "common-tags": "catalog:utils",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:publish",
    "@microblink/repo-utils": "workspace:*",
    "@microblink/test-utils": "workspace:*",
    "@microblink/tsconfig": "workspace:*",
    "@microblink/wasm-common": "workspace:*",
    "@microblink/worker-common": "workspace:*",
    "@types/common-tags": "catalog:",
    "@typescript/native": "catalog:typescript",
    "@vitest/browser-playwright": "catalog:test",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "playwright": "catalog:test",
    "publint": "catalog:publish",
    "rimraf": "catalog:utils",
    "tsx": "catalog:typescript",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:test",
    "write-package": "catalog:publish",
    "zx": "catalog:utils"
  },
  "browserslist": [
    "Chrome >= 96",
    "ChromeAndroid >= 96",
    "Edge >= 96",
    "Opera >= 84",
    "Firefox >= 114",
    "FirefoxAndroid >= 114",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ]
}
