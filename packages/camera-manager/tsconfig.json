{
  "extends": "@microblink/tsconfig/base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declarationDir": "types",
    "rootDir": "src",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@microblink/camera-manager/core": ["./src/core.ts"]
    },
    "types": ["vite/client", "vite-plugin-solid-svg/types", "unplugin-icons/types/solid"]
  },
  "include": ["src", "~icons"]
}
