{
  "name": "@microblink/camera-manager",
  "version": "8.0.1",
  "description": "Manages cameras and stream, provides both a headless component and a UI component",
  "keywords": [],
  "license": "ISC",
  "author": "Microblink",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "./dist/camera-manager.js",
  "module": "./dist/camera-manager.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/camera-manager.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./ui": {
      "types": "./types/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "publish",
    "linkDirectory": false
  },
  "scripts": {
    "build": "pnpm run --no-bail \"/^build:(js|types)$/\"",
    "build:js": "vite build --mode ${VITE_BUILD_MODE:-production}",
    "build:js-dev": "vite build --mode development",
    "build:publish": "pnpm build && pnpm type-rollup",
    "build:types": "tsc",
    "clean": "rimraf .turbo types dist publish public/resources/* *.tgz",
    "docs:api": "typedoc",
    "lint:browser-entrypoints": "BROWSERSLIST_ENV=core oxlint src/core.ts src/core && BROWSERSLIST_ENV=ui oxlint src/ui.ts src/ui",
    "pack-check": "pnpm pack | tail -n1 | xargs attw --profile esm-only && publint publish",
    "prepack": "pnpm prepare-publish",
    "prepare-publish": "tsx scripts/prepare-publish.mts",
    "publish-test": "pnpm prepare-publish && pnpm pack-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-rollup": "api-extractor run --local --config api-extractor.core.json && api-extractor run --local --config api-extractor.ui.json && tsx ../repo-utils/write-compatibility-declaration-rollup.mts",
    "watch": "pnpm run --no-bail \"/^watch:(js|types)$/\"",
    "watch:js": "pnpm run build:js --watch --mode development",
    "watch:types": "pnpm run build:types --watch",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@solid-primitives/resize-observer": "catalog:ui",
    "@wessberg/connection-observer": "^1.0.5",
    "common-tags": "catalog:utils",
    "perfect-debounce": "catalog:",
    "rad-event-listener": "^0.2.4",
    "rvfc-polyfill": "^1.0.7",
    "type-fest": "catalog:",
    "zustand": "catalog:ui"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:publish",
    "@iconify-json/material-symbols": "^1.2.14",
    "@iconify-json/mdi": "^1.2.3",
    "@microblink/repo-utils": "workspace:*",
    "@microblink/shared-components": "workspace:^",
    "@microblink/test-utils": "workspace:*",
    "@microblink/tsconfig": "workspace:*",
    "@microblink/unocss-config": "workspace:*",
    "@microsoft/api-extractor": "catalog:typescript",
    "@types/common-tags": "catalog:",
    "@typescript/native": "catalog:typescript",
    "@vitest/browser-playwright": "catalog:test",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "playwright": "catalog:test",
    "publint": "catalog:publish",
    "rimraf": "catalog:utils",
    "sass": "catalog:ui",
    "tsx": "catalog:typescript",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "unocss": "catalog:ui",
    "unplugin-icons": "^22.0.0",
    "vite": "catalog:vite",
    "vite-plugin-css-injected-by-js": "catalog:vite",
    "vite-plugin-externalize-dependencies": "catalog:vite",
    "vite-plugin-solid": "catalog:vite",
    "vite-plugin-solid-svg": "catalog:vite",
    "vitest": "catalog:test",
    "write-package": "catalog:publish",
    "zx": "catalog:utils"
  },
  "peerDependencies": {
    "@ark-ui/solid": "catalog:ui",
    "@solid-primitives/keyed": "catalog:ui",
    "solid-js": "catalog:ui",
    "solid-zustand": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "@ark-ui/solid": {
      "optional": true
    },
    "@solid-primitives/keyed": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "solid-zustand": {
      "optional": true
    }
  },
  "browserslist": {
    "production": [
      "Chrome >= 91",
      "ChromeAndroid >= 91",
      "Edge >= 91",
      "Opera >= 84",
      "Firefox >= 132",
      "Safari >= 15.4",
      "iOS >= 15.4"
    ],
    "core": [
      "Chrome >= 91",
      "ChromeAndroid >= 91",
      "Edge >= 91",
      "Opera >= 84",
      "Firefox >= 132",
      "Safari >= 15.4",
      "iOS >= 15.4"
    ],
    "ui": [
      "Chrome >= 91",
      "ChromeAndroid >= 91",
      "Edge >= 91",
      "Opera >= 84",
      "Firefox >= 132",
      "Safari >= 15.4",
      "iOS >= 15.4"
    ]
  }
}
