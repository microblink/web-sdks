{
  "name": "@microblink/blinkid-wasm",
  "version": "8002.0.0",
  "private": true,
  "description": "BlinkID Wasm runtime",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "src/index.ts",
  "module": "./dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./BlinkIdRecognizerVersion": {
      "types": "./src/BlinkIdRecognizerVersion.ts",
      "import": "./src/BlinkIdRecognizerVersion.ts"
    },
    "./size-manifest.json": {
      "types": "./src/size-manifest.d.ts",
      "default": "./dist/size-manifest.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:publish": "tsc",
    "clean": "rimraf .turbo types",
    "docs:api": "typedoc",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "devDependencies": {
    "@microblink/tsconfig": "workspace:*",
    "@microblink/wasm-common": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "dotenv-cli": "catalog:utils",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "tsx": "catalog:typescript",
    "type-fest": "catalog:",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "zx": "catalog:utils"
  }
}
