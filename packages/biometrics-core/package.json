{
  "name": "@microblink/biometrics-core",
  "version": "1000.0.0",
  "description": "Biometrics Core SDK",
  "keywords": [],
  "license": "ISC",
  "author": "Microblink",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "./dist/biometrics-core.js",
  "module": "./dist/biometrics-core.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/biometrics-core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "publish",
    "linkDirectory": false
  },
  "scripts": {
    "build": "pnpm run --no-bail \"/^build:(js|types)$/\"",
    "build:js": "vite build",
    "build:js-dev": "vite build --mode development",
    "build:publish": "pnpm build && pnpm type-rollup",
    "build:types": "tsc",
    "clean": "rimraf .turbo types dist publish public/resources/* *.tgz",
    "docs:api": "typedoc",
    "format": "pnpm exec oxfmt src",
    "pack-check": "pnpm pack | tail -n1 | xargs attw --profile esm-only && publint publish",
    "prepack": "pnpm prepare-publish",
    "prepare-publish": "tsx scripts/prepare-publish.mts",
    "publish-test": "pnpm build:publish && pnpm prepare-publish && pnpm pack-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-rollup": "bundle-declarations --entry index --bundle @microblink/analytics --bundle @microblink/biometrics-common --bundle @microblink/biometrics-wasm --bundle @microblink/biometrics-worker --bundle @microblink/core-common --bundle @microblink/feedback-stabilizer --bundle @microblink/worker-common",
    "watch": "pnpm run --no-bail \"/^watch:(js|types)$/\"",
    "watch:js": "vite build --mode development && pnpm run watch:js:vite",
    "watch:types": "pnpm run build:types --watch",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit",
    "watch:js:vite": "vite build --watch --mode development --emptyOutDir=false"
  },
  "dependencies": {
    "@microblink/analytics": "workspace:*",
    "@microblink/biometrics-common": "workspace:*",
    "@microblink/biometrics-wasm": "workspace:*",
    "@microblink/biometrics-worker": "workspace:*",
    "@microblink/core-common": "workspace:*",
    "@microblink/feedback-stabilizer": "workspace:*",
    "@microblink/worker-common": "workspace:*",
    "comlink": "catalog:",
    "zustand": "catalog:ui"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:publish",
    "@microblink/repo-utils": "workspace:*",
    "@microblink/tsconfig": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "publint": "catalog:publish",
    "rimraf": "catalog:utils",
    "tsx": "catalog:typescript",
    "type-fest": "catalog:",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:test",
    "write-package": "catalog:publish",
    "zx": "catalog:utils"
  },
  "browserslist": [
    "Chrome >= 96",
    "ChromeAndroid >= 96",
    "Edge >= 96",
    "Opera >= 84",
    "Firefox >= 132",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ]
}
