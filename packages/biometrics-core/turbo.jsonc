{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "types/**", "public/resources/**"],
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "inputs": ["$TURBO_DEFAULT$"],
    },
    "typecheck": {
      "dependsOn": ["^build:types"],
      "inputs": ["$TURBO_DEFAULT$"],
    },
  },
}
