{
  "name": "@microblink/wasm-common",
  "version": "2.3.0",
  "private": true,
  "description": "Common utilities and types for wasm packages",
  "files": [
    "types"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:publish": "tsc",
    "clean": "rimraf .turbo types",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "devDependencies": {
    "@microblink/tsconfig": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "tsx": "catalog:typescript",
    "typescript": "catalog:typescript",
    "zx": "catalog:utils"
  }
}
