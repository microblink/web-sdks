  "private": true,
  "description": "Analytics",
  "keywords": [],
  "license": "ISC",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "exports": {
    "./AnalyticService": {
      "types": "./types/AnalyticService.d.ts",
      "import": "./dist/AnalyticService.js"
    },
    "./ping": {
