{
  "name": "@microblink/feedback-stabilizer",
  "version": "7.1.5",
  "private": true,
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/FeedbackStabilizer.d.ts",
      "import": "./dist/FeedbackStabilizer.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:types": "tsc --emitDeclarationOnly",
    "build:publish": "tsc",
    "clean": "rimraf .turbo types dist *.tgz",
    "docs:api": "typedoc",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@microblink/tsconfig": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "type-fest": "catalog:",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "vitest": "catalog:test"
  }
}
