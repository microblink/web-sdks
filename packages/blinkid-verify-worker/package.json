{
  "name": "@microblink/blinkid-verify-worker",
  "version": "4000.0.0-next.1",
  "private": true,
  "description": "Provides a worker which runs the BlinkID WebAssembly in separate thread",
  "files": [
    "dist",
    "types"
  ],
  "main": "dist/blinkid-verify-worker.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/blinkid-verify-worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run --no-bail \"/^build:(js|types)$/\"",
    "build:dev": "pnpm run --no-bail \"/^build:(js-dev|types)$/\"",
    "build:js": "vite build",
    "build:js-dev": "vite build --mode development",
    "build:publish": "pnpm build",
    "build:types": "tsc",
    "clean": "rimraf .turbo types dist public/resources/*",
    "docs:api": "typedoc",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "watch": "pnpm run --no-bail \"/^watch:(js|types)$/\"",
    "watch:js": "vite build --mode development --watch",
    "watch:types": "tsc --watch",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@microblink/analytics": "workspace:^",
    "@microblink/blinkid-verify-wasm": "workspace:*",
    "@microblink/worker-common": "workspace:*",
    "comlink": "catalog:",
    "merge-anything": "catalog:"
  },
  "devDependencies": {
    "@microblink/repo-utils": "workspace:*",
    "@microblink/test-utils": "workspace:*",
    "@microblink/tsconfig": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "tsx": "catalog:typescript",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:test",
    "zx": "catalog:utils"
  },
  "browserslist": [
    "Chrome >= 96",
    "ChromeAndroid >= 96",
    "Edge >= 96",
    "Opera >= 84",
    "Firefox >= 114",
    "FirefoxAndroid >= 114",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ]
}
