{
  "name": "@microblink/core-common",
  "version": "1.0.2",
  "private": true,
  "keywords": [],
  "license": "ISC",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "exports": {
    "./createProxyWorker": {
      "types": "./types/createProxyWorker.d.ts",
      "import": "./dist/createProxyWorker.js"
    },
    "./getCrossOriginWorkerURL": {
      "types": "./types/getCrossOriginWorkerURL.d.ts",
      "import": "./dist/getCrossOriginWorkerURL.js"
    },
    "./getUserId": {
      "types": "./types/getUserId.d.ts",
      "import": "./dist/getUserId.js"
    },
    "./shouldUseLightweightBuild": {
      "types": "./types/shouldUseLightweightBuild.d.ts",
      "import": "./dist/shouldUseLightweightBuild.js"
    },
    "./deviceInfo/deviceInfo": {
      "types": "./types/deviceInfo/deviceInfo.d.ts",
      "import": "./dist/deviceInfo/deviceInfo.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:types": "tsc --emitDeclarationOnly",
    "build:publish": "tsc",
    "clean": "rimraf .turbo types dist *.tgz",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "comlink": "catalog:",
    "common-tags": "catalog:utils",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@microblink/tsconfig": "workspace:*",
    "@types/common-tags": "catalog:",
    "@typescript/native": "catalog:typescript",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "typescript": "catalog:typescript",
    "vitest": "catalog:test"
  }
}
