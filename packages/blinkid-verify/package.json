{
  "name": "@microblink/blinkid-verify",
  "version": "4000.0.0-next.1",
  "description": "All-in-one BlinkID Verify browser SDK for fast and accurate ID verification in web applications.",
  "keywords": [
    "aml",
    "blinkid",
    "blinkid-verify",
    "compliance",
    "computer-vision",
    "document-authentification",
    "document-scanner",
    "document-verification",
    "driver-license",
    "fraud-detection",
    "frontend",
    "id-check",
    "id-verification",
    "image-processing",
    "kyc",
    "microblink",
    "ocr",
    "passport-verification",
    "typescript",
    "verification",
    "verify",
    "video",
    "wasm",
    "webassembly"
  ],
  "license": "ISC",
  "author": "Microblink",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "dist/blinkid-verify.js",
  "module": "./dist/blinkid-verify.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/blinkid-verify.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "publish",
    "linkDirectory": false
  },
  "scripts": {
    "build": "pnpm run --no-bail \"/^build:(js|types)$/\"",
    "build:dev": "pnpm run --no-bail \"/^build:(js-dev|types)$/\"",
    "build:js": "vite build --mode ${VITE_BUILD_MODE:-production}",
    "build:js-dev": "vite build --mode development",
    "build:publish": "pnpm build && pnpm type-rollup",
    "build:types": "tsc",
    "clean": "rimraf .turbo types dist publish public/resources/* *.tgz",
    "docs:api": "typedoc",
    "pack-check": "pnpm pack | tail -n1 | xargs attw --profile esm-only && publint publish",
    "prepack": "pnpm prepare-publish",
    "prepare-publish": "tsx scripts/prepare-publish.mts",
    "publish-test": "pnpm pack-check",
    "type-rollup": "bundle-declarations --entry index",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@microblink/blinkid-verify-core": "workspace:^",
    "@microblink/blinkid-verify-ux-manager": "workspace:^",
    "@microblink/camera-manager": "workspace:^",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:publish",
    "@microblink/repo-utils": "workspace:*",
    "@microblink/test-utils": "workspace:*",
    "@microblink/tsconfig": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "publint": "catalog:publish",
    "rimraf": "catalog:utils",
    "tsx": "catalog:typescript",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "write-package": "catalog:publish",
    "zx": "catalog:utils"
  },
  "browserslist": [
    "Chrome >= 96",
    "ChromeAndroid >= 96",
    "Edge >= 96",
    "Opera >= 84",
    "Firefox >= 132",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ]
}
