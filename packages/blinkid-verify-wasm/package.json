{
  "name": "@microblink/blinkid-verify-wasm",
  "version": "4000.0.0-next.0",
  "private": true,
  "description": "BlinkIdVerify Wasm runtime",
  "keywords": [
    "aml",
    "blinkid",
    "blinkid-verify",
    "compliance",
    "computer-vision",
    "document-authentification",
    "document-scanner",
    "document-verification",
    "driver-license",
    "fraud-detection",
    "frontend",
    "id-check",
    "id-verification",
    "image-processing",
    "kyc",
    "microblink",
    "ocr",
    "passport-verification",
    "typescript",
    "verification",
    "verify",
    "video",
    "wasm",
    "webassembly"
  ],
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "src/index.ts",
  "module": "./dist/index.js",
  "types": "src/index.ts",
  "imports": {
    "#BlinkIdVerifyModule": "./dist/simd/BlinkIdVerifyModule.js",
    "#BlinkIdVerifyModuleTest": "./dist_test/simd/BlinkIdVerifyModule_Test.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./size-manifest.json": {
      "types": "./src/size-manifest.d.ts",
      "default": "./dist/size-manifest.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:publish": "tsc",
    "clean": "rimraf .turbo types",
    "docs:api": "typedoc",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "devDependencies": {
    "@microblink/tsconfig": "workspace:*",
    "@microblink/wasm-common": "workspace:*",
    "@typescript/native": "catalog:typescript",
    "@vitest/browser-playwright": "catalog:test",
    "arktype": "^2.2.0",
    "dotenv-cli": "catalog:utils",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "tsx": "catalog:typescript",
    "typedoc": "catalog:typescript",
    "typedoc-plugin-markdown": "catalog:publish",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:test",
    "zx": "catalog:utils"
  }
}
