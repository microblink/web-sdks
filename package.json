{
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:force": "TURBO_FORCE=1 turbo run build",
    "build:packages": "VITE_BUILD_MODE=development turbo build --filter={./packages/*}",
    "build:blinkid": "turbo build --filter=@microblink/blinkid...",
    "watch:blinkid": "turbo watch build --filter=@microblink/blinkid...",
    "build:blinkcard": "turbo build --filter=@microblink/blinkcard...",
    "watch:blinkcard": "turbo watch build --filter=@microblink/blinkcard...",
    "build:blinkid-verify": "turbo build --filter=@microblink/blinkid-verify...",
    "build:publish": "turbo build:publish --filter={./packages/*}",
    "clean:blinkid": "turbo clean --filter=@microblink/blinkid...",
    "clean:blinkcard": "turbo clean --filter=@microblink/blinkcard...",
    "clean:blinkid-verify": "turbo clean --filter=@microblink/blinkid-verify...",
    "clean": "turbo clean && rimraf .turbo .venv",
    "lint": "pnpm lint:prepare && BROWSERSLIST_ENV=production oxlint && pnpm lint:browser-entrypoints",
    "lint:browser-entrypoints": "pnpm --filter @microblink/camera-manager --filter './packages/*-ux-manager' --parallel run lint:browser-entrypoints",
    "lint:ci": "pnpm lint:prepare && BROWSERSLIST_ENV=production oxlint --threads=4 && pnpm lint:browser-entrypoints",
    "lint:fix": "pnpm lint:prepare && BROWSERSLIST_ENV=production oxlint --fix && pnpm lint:browser-entrypoints",
    "lint:prepare": "turbo run build:types --concurrency=2 --summarize",
    "lint:browserlist": "turbo run lint:browserslist",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "typecheck": "turbo run typecheck --concurrency=2 --summarize",
    "publish-test": "turbo publish-test",
    "test": "vitest run --pool=threads",
    "test:coverage": "vitest run --pool=threads --coverage",
    "test:turbo": "turbo test",
    "test:watch": "vitest",
    "test:blinkid": "turbo test --filter=@microblink/blinkid...",
    "test:blinkcard": "turbo test --filter=@microblink/blinkcard...",
    "test:blinkid-verify": "turbo test --filter=@microblink/blinkid-verify...",
    "upgrade-packages": "pnpm dlx npm-check-updates -ui -ws --root",
    "watch": "turbo watch --filter='./packages/*'",
    "knip": "knip"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@mdn/browser-compat-data": "^8.0.10",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:test",
    "browserslist": "^4.25.2",
    "eslint-plugin-compat": "6.0.2",
    "eslint-plugin-solid": "0.14.5",
    "happy-dom": "catalog:test",
    "knip": "6.29.0",
    "lefthook": "2.1.12",
    "nano-staged": "1.0.2",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-plugin-oxfmt": "0.1.0",
    "oxlint-tsgolint": "catalog:oxc",
    "rimraf": "catalog:utils",
    "turbo": "^2.8.10",
    "typescript": "catalog:typescript",
    "vitest": "catalog:test",
    "zx": "catalog:utils"
  },
  "packageManager": "pnpm@11.18.0"
}
