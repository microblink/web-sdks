{
  "$schema": "https://v2-8-9.turborepo.dev/schema.json",
  "globalDependencies": ["packages/tsconfig/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "types/**"],
      "outputLogs": "new-only",
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["types/**"],
      "outputLogs": "new-only",
    },
    "build:publish": {
      "dependsOn": ["^build:publish"],
      "cache": false,
    },
    "lint:browserslist": {
      "cache": false,
    },
    "lint:toolchain": {
      "cache": false,
    },
    "typecheck": {
      "dependsOn": ["^build:types"],
      "outputs": [],
    },
    "publish-test": {
      "dependsOn": ["build:publish"],
      "cache": false,
    },
    "test": {
      "cache": false,
    },
    "clean": {
      "cache": false,
      "outputs": [],
    },
  },
}
